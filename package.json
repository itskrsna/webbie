{
  "name": "webruster-resume",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://krishnakishore.tk",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "test": "jest --watch",
    "test:ci": "jest --ci",
    "cypress": "cypress open",
    "cypress:headless": "cypress run",
    "e2e": "start-server-and-test dev http://localhost:3000 cypress",
    "e2e:headless": "start-server-and-test dev http://localhost:3000 cypress:headless",
    "start": "next start -p 3000",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:fix": "npm run lint:code:fix && npm run lint:styles:fix",
    "lint:code": "eslint .",
    "lint:code:fix": "eslint . --fix",
    "lint:styles": "stylelint ./**/*.scss",
    "lint:styles:fix": "stylelint --fix ./**/*.scss",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "icons": "svgr --typescript --memo --icon --replace-attr-values '#fff=currentColor' --template icons/icon-template.js ./icons/svg --out-dir src/icons",
    "prepare": "husky"
  },
  "dependencies": {
    "camelcase": "^8.0.0",
    "framer-motion": "^12.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^19.0.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-intersection-observer": "^9.16.0",
    "react-markdown": "^10.0.0",
    "react-share": "^5.2.0",
    "react-syntax-highlighter": "^16.1.2",
    "reading-time": "^1.5.0",
    "sitemap": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@svgr/cli": "^8.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.20",
    "cypress": "^15.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "husky": "^9.1.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "lint-staged": "^16.0.0",
    "postcss": "^8.4.49",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^16.1.0",
    "postcss-preset-env": "^10.0.0",
    "prettier": "^3.4.0",
    "sass": "^1.83.0",
    "start-server-and-test": "^2.0.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.scss": "stylelint --fix"
  }
}
